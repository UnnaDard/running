name: Sync Strava

on:
  schedule:
    # 06:00 UTC daily = 2pm Perth time. Adjust if you'd rather it ran earlier.
    - cron: "0 6 * * *"
  workflow_dispatch:        # lets you run it manually from the Actions tab

permissions:
  contents: write           # needed to commit data.json back to the repo

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Fetch Strava data
        env:
          STRAVA_CLIENT_ID: ${{ secrets.STRAVA_CLIENT_ID }}
          STRAVA_CLIENT_SECRET: ${{ secrets.STRAVA_CLIENT_SECRET }}
          STRAVA_REFRESH_TOKEN: ${{ secrets.STRAVA_REFRESH_TOKEN }}
        run: python scripts/fetch_strava.py

      - name: Commit if changed
        run: |
          git config user.name "strava-sync"
          git config user.email "actions@github.com"
          git add data.json
          if git diff --staged --quiet; then
            echo "No change."
          else
            git commit -m "Sync Strava data"
            git push
          fi
